{
  "$schema": "../rulings.schema.json",
  "id": "a-synchro-monsters-other-materials-are-non-tuners",
  "statement": "A Synchro Monster's materials after its Tuner are non-Tuners, whether or not its materials line says so.",
  "kind": "MEANING",
  "region": "OCG",
  "status": "APPLIED",
  "sources": [
    {
      "from": "RULEBOOK",
      "where": "Official Rulebook, version 10.0: Synchro Summon",
      "says": "A Synchro Summon uses 1 Tuner and non-Tuner monsters."
    }
  ],
  "scripts": "ocgcore and the scripts agree.",
  "examples": [
    {
      "card": 93172951,
      "name": "Clown Crew Meteor",
      "path": "summons/0/materials/1/role",
      "value": "NON_TUNER"
    }
  ]
}
