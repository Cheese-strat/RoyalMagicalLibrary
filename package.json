{
  "name": "royal-magical-library",
  "version": "0.1.0",
  "private": true,
  "description": "Reads Yu-Gi-Oh! card scripts (YGOPro Lua) into structured data",
  "type": "module",
  "scripts": {
    "read": "tsx src/cli.ts read",
    "survey": "tsx --max-semi-space-size=256 src/cli.ts survey",
    "parse-check": "tsx tools/parseAll.ts",
    "check": "tsc --noEmit -p .",
    "text-check": "tsx --max-semi-space-size=256 src/cli.ts text-check"
  },
  "dependencies": {
    "koishipro-core.js": "^1.5.5",
    "luaparse": "^0.3.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/node": "^26.6.4",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
