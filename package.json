{
  "name": "royal-magical-library",
  "version": "0.1.0",
  "private": true,
  "description": "Describes Yu-Gi-Oh! cards from their text, and writes each engine's scripts from that",
  "type": "module",
  "scripts": {
    "build": "tsx --max-semi-space-size=256 src/cli.ts build",
    "report": "tsx --max-semi-space-size=256 src/cli.ts report",
    "inspect": "tsx src/cli.ts inspect",
    "release": "tsx src/release.ts",
    "check": "tsc --noEmit -p .",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "koishipro-core.js": "^1.5.5",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
